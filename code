<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>刃物検知アラートシステム</title>
  <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@latest/dist/tf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@teachablemachine/image@latest/dist/teachablemachine-image.min.js"></script>
  <style>
    body { font-family: sans-serif; text-align: center; margin-top: 30px; }
    #webcam-container { margin: 20px auto; }
    #label-container { font-size: 1.2rem; font-weight: bold; margin-top: 10px; }
    .alert-text { color: red; font-size: 1.5rem; display: none; margin-top: 15px; }
    button { font-size: 1rem; padding: 10px 20px; cursor: pointer; }
  </style>
</head>
<body>

  <h1>刃物検知カメラ</h1>
  <button type="button" onclick="init()">カメラ起動・監視開始</button>
  
  <div id="webcam-container"></div>
  <div id="label-container"></div>
  <div id="alert-msg" class="alert-text">⚠️ 刃物を検知しました！</div>

  <script type="text/javascript">
    // ★1. Teachable MachineでエクスポートしたモデルのURLに書き換えてください
    const URL = "https://teachablemachine.withgoogle.com/models/-G2jboOJG/";

    // ★2. Teachable Machineで設定した刃物のクラス名を入力してください
    const TARGET_CLASS = "刃物"; // 例: "Knife", "knife", "刃物" など

    // ★3. 警告音を鳴らすしきい値（0.8 = 確率80%以上）
    const THRESHOLD = 0.9;

    let model, webcam, labelContainer, maxPredictions;
    let audioCtx = null;
    let isBeeping = false;

    // Web Audio API を使ったビープ音発生機能（音源ファイル不要）
    function playAlertSound() {
      if (isBeeping) return;
      isBeeping = true;

      // ブラウザの音声文脈を初期化
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = 'sawtooth'; // 鋭い警報音用の波形
      osc.frequency.setValueAtTime(880, audioCtx.currentTime); // 周波数 880Hz (ラ)

      gain.gain.setValueAtTime(0.2, audioCtx.currentTime);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();

      // 0.2秒間鳴らして停止
      setTimeout(() => {
        osc.stop();
        isBeeping = false;
      }, 200);
    }

    async function init() {
      const modelURL = URL + "model.json";
      const metadataURL = URL + "metadata.json";

      model = await tmImage.load(modelURL, metadataURL);
      maxPredictions = model.getTotalClasses();

      const flip = true; // 画像の左右反転
      webcam = new tmImage.Webcam(320, 240, flip);
      await webcam.setup();
      await webcam.play();
      window.requestAnimationFrame(loop);

      document.getElementById("webcam-container").appendChild(webcam.canvas);
      labelContainer = document.getElementById("label-container");
      for (let i = 0; i < maxPredictions; i++) {
        labelContainer.appendChild(document.createElement("div"));
      }
    }

    async function loop() {
      webcam.update();
      await predict();
      window.requestAnimationFrame(loop);
    }

    async function predict() {
      const prediction = await model.predict(webcam.canvas);
      let detected = false;

      for (let i = 0; i < maxPredictions; i++) {
        const className = prediction[i].className;
        const probability = prediction[i].probability;

        labelContainer.childNodes[i].innerHTML = 
          `${className}: ${(probability * 100).toFixed(0)}%`;

        // 判定処理
        if (className === TARGET_CLASS && probability >= THRESHOLD) {
          detected = true;
        }
      }

      const alertMsg = document.getElementById("alert-msg");
      if (detected) {
        playAlertSound();
        alertMsg.style.display = "block";
      } else {
        alertMsg.style.display = "none";
      }
    }
  </script>
</body>
</html>
